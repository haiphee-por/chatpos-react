# SMS/OTP delivery is owned by the PD/Agent Backoffice.
# ChatPOS does not store SMS credentials or call an SMS provider directly.
KYC_OTP_TTL_SECONDS="300"
KYC_OTP_MAX_ATTEMPTS="5"
KYC_OTP_RESEND_COOLDOWN_SECONDS="60"
KYC_OTP_LOCK_SECONDS="900"

LLGW_PAYMENT_WEBHOOK_ENABLED="false"
LLGW_PAYMENT_WEBHOOK_SECRET=""
LLGW_PAYMENT_WEBHOOK_SECRET_PREVIOUS=""
LLGW_PAYMENT_TIMESTAMP_TOLERANCE_SECONDS="300"
PAYMENT_STATUS_WEBHOOK_ENABLED="false"
PAYMENT_STATUS_WEBHOOK_SECRET=""
PAYMENT_STATUS_WEBHOOK_SECRET_PREVIOUS=""
PAYMENT_STATUS_TIMESTAMP_TOLERANCE_SECONDS="300"

# Upstream settlement -> commission contract (disabled until field mapping is approved)
COMMISSION_EVENT_INGEST_ENABLED="false"
COMMISSION_EVENT_SOURCE_URL=""
COMMISSION_EVENT_WEBHOOK_SECRET=""
COMMISSION_PD_GROSS_BENEFIT_FIELD=""

# Database Configuration (Template)
PGHOST="188.166.216.95"
PGPORT="8432"
PGUSER="chatpos"
PGPASSWORD="your_password_here"
PGDATABASE="chatpos-biz-prod"
DATABASE_URL="postgresql://chatpos:your_password_here@188.166.216.95:8432/chatpos-biz-prod?schema=public"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
AUTH_LOGIN_RATE_LIMIT="8"
AUTH_LOGIN_RATE_WINDOW_SECONDS="300"
SETTLEMENT_RETRY_INTERVAL_MS="30000"
SETTLEMENT_MAX_ATTEMPTS="8"
DOCUMENT_SCANNER_URL=""
DOCUMENT_SCANNER_TOKEN=""
DOCUMENT_SCANNER_TIMEOUT_MS="15000"

# Agent/PD Backoffice signed Merchant API (disabled until contract and staging sign-off)
# Production domain, Store mapping, Key ID and secrets are loaded from backoffice_store_credentials.
AGENT_PD_KEY_ID_HEADER="X-ChatPOS-Key-Id"
AGENT_PD_CREDENTIAL_ENVIRONMENT="development"
AGENT_PD_INTEGRATION_ENABLED="false"
AGENT_PD_ASSIGNMENT_ENABLED="false"
MERCHANT_PROFILE_UPDATE_ENABLED="false"
KYC_DOCUMENT_INTAKE_ENABLED="false"
MERCHANT_HOME_CONTRACT_ENABLED="false"
TRANSACTION_ROUTING_ENABLED="false"
TRANSACTION_QUERY_ROUTING_ENABLED="false"
AGENT_PD_REQUEST_TIMEOUT_MS="15000"
AGENT_PD_MAX_RETRIES="3"
AGENT_PD_RETRY_BASE_DELAY_MS="250"
AGENT_PD_MAX_RETRY_DELAY_MS="30000"
AGENT_PD_TIMESTAMP_TOLERANCE_SECONDS="300"
AGENT_PD_TRANSACTION_COMMAND_PATH="/api/v1/transactions"
AGENT_PD_TRANSACTION_QUERY_PATH="/api/v1/transactions/{id}/payment"
